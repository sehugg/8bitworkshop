                                    463         ;; Macro definitions
                                    464 
                                    465 .macro WAIT_STAT ?lbl
                                    466 lbl:    LDH     A, (.STAT)
                                    467         AND     #STATF_BUSY     ; Check if in LCD modes 0 or 1
                                    468         JR      NZ, lbl
                                    469 .endm
                                    470 
                                    471 .macro ADD_A_REG16 regH regL
                                    472         ADD     regL
                                    473         LD      regL, A
                                    474         ADC     regH
                                    475         SUB     regL
                                    476         LD      regH, A
                                    477 .endm
