      000293                        369 gsinit::
                                    370         ;; initialize static storage variables
      000293 01 00 00         [12]  371         LD      BC, #l__INITIALIZER
      000296 21 93 02         [12]  372         LD      HL, #s__INITIALIZER
      000299 11 B9 C0         [12]  373         LD      DE, #s__INITIALIZED
