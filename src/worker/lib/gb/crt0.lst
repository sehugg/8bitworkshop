      000040                         43 .int_VBL:
      000040 F5               [16]   44         PUSH    AF
      000041 E5               [16]   45         PUSH    HL
      000042 21 A5 C0         [12]   46         LD      HL,#.int_0x40
      000045 C3 80 00         [16]   47         JP      .int
