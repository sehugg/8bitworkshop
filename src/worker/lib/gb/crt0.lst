                                    479 .macro SIGNED_ADD_A_REG16 regH regL ?lbl
                                    480         ; If A is negative, we need to subtract 1 from upper byte of 16-bit value
                                    481         BIT     7, A            ; set z if a signed bit is 0
                                    482         JR      Z, lbl          ; if z is set jump to positive
                                    483         dec     regH            ; if negative decrement upper byte
                                    484 lbl:
                                    485         ADD_A_REG16     regH, regL
                                    486 .endm
                                    487 
                                    488 .macro SIGNED_SUB_A_REG16 regH regL ?lbl
                                    489         ; negate A then add to 16-bit value
                                    490         CPL
                                    491         INC     A
                                    492         SIGNED_ADD_A_REG16      regH, regL
                                    493 .endm
                                    494 
                                    495 .macro MUL_DE_BY_A_RET_HL ?lbl1 ?lbl2
                                    496         ; Multiply DE by A, return result in HL; preserves: BC
                                    497         LD      HL, #0
                                    498 lbl1:
                                    499         SRL     A
                                    500         JR      NC, lbl2
                                    501         ADD     HL, DE
                                    502 lbl2:
                                    503         SLA     E
                                    504         RL      D
                                    505         OR      A
                                    506         JR      NZ, lbl1
                                    507 .endm
                                    508 
