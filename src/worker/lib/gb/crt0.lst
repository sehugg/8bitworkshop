      000080 C5               [16]   62         PUSH    BC
      000081 D5               [16]   63         PUSH    DE
      000082                         64 1$:
      000082 2A               [ 8]   65         LD      A,(HL+)
      000083 B6               [ 8]   66         OR      (HL)
      000084 28 0B            [12]   67         JR      Z,.int_tail
      000086 E5               [16]   68         PUSH    HL
      000087 3A               [ 8]   69         LD      A,(HL-)
      000088 6E               [ 8]   70         LD      L,(HL)
      000089 67               [ 4]   71         LD      H,A
      00008A E7               [16]   72         RST     0x20            ; .call_hl
      00008B E1               [12]   73         POP     HL
      00008C 23               [ 8]   74         INC     HL
      00008D 18 F3            [12]   75         JR      1$
      00008F                         76 _wait_int_handler::    
