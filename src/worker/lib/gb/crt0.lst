      000160 7A               [ 4]  209         LD      A, D
      000161 EA A0 C0         [16]  210         LD      (__cpu), A
      000164 FE 11            [ 8]  211         CP      #.CGB_TYPE
      000166 20 07            [12]  212         JR      NZ, 1$
      000168 AF               [ 4]  213         XOR     A
      000169 CB 3B            [ 8]  214         SRL     E
      00016B 17               [ 4]  215         RLA
      00016C EA A1 C0         [16]  216         LD      (__is_GBA), A
      00016F                        217 1$:
                                    218         ;; Turn the screen off
      00016F CD 65 02         [24]  219         CALL    .display_off
                                    220 
      000172 AF               [ 4]  221         XOR     A
                                    222         ;; Initialize the display
      000173 E0 42            [12]  223         LDH     (.SCY),A
      000175 E0 43            [12]  224         LDH     (.SCX),A
      000177 E0 41            [12]  225         LDH     (.STAT),A
      000179 E0 4A            [12]  226         LDH     (.WY),A
      00017B 3E 07            [ 8]  227         LD      A,#0x07
      00017D E0 4B            [12]  228         LDH     (.WX),A
                                    229 
                                    230         ;; Copy refresh_OAM routine to HRAM
      00017F 11 C6 01         [12]  231         LD      DE,#.start_refresh_OAM                          ; source
      000182 21 80 FF         [12]  232         LD      HL,#.refresh_OAM                                ; dest
      000185 0E 0C            [ 8]  233         LD      C,#(.end_refresh_OAM - .start_refresh_OAM)      ; size
      000187 F7               [16]  234         RST     0x30                                            ; call .MemcpySmall
                                    235 
                                    236         ;; Clear the OAM by calling refresh_OAM
      000188 CD 80 FF         [24]  237         CALL    .refresh_OAM
                                    238 
                                    239         ;; Install interrupt routines
      00018B 01 9C 00         [12]  240         LD      BC,#.std_vbl
      00018E CD 47 02         [24]  241         CALL    .add_VBL
                                    242 
                                    243         ;; Standard color palettes
      000191 3E E4            [ 8]  244         LD      A,#0b11100100   ; Grey 3 = 11 (Black)
                                    245                                 ; Grey 2 = 10 (Dark grey)
                                    246                                 ; Grey 1 = 01 (Light grey)
                                    247                                 ; Grey 0 = 00 (Transparent)
      000193 E0 47            [12]  248         LDH     (.BGP),A
      000195 E0 48            [12]  249         LDH     (.OBP0),A
      000197 3E 1B            [ 8]  250         LD      A,#0b00011011
      000199 E0 49            [12]  251         LDH     (.OBP1),A
                                    252 
                                    253         ;; Turn the screen on
      00019B 3E C0            [ 8]  254         LD      A,#(LCDCF_ON | LCDCF_WIN9C00 | LCDCF_WINOFF | LCDCF_BG8800 | LCDCF_BG9800 | LCDCF_OBJ8 | LCDCF_OBJOFF | LCDCF_BGOFF)
      00019D E0 40            [12]  255         LDH     (.LCDC),A
      00019F AF               [ 4]  256         XOR     A
      0001A0 E0 0F            [12]  257         LDH     (.IF),A
      0001A2 3E 01            [ 8]  258         LD      A,#.VBL_IFLAG   ; switch on VBlank interrupt only
      0001A4 E0 FF            [12]  259         LDH     (.IE),A
                                    260 
      0001A6 E0 90            [12]  261         LDH     (__current_bank),A      ; current bank is 1 at startup
                                    262 
      0001A8 AF               [ 4]  263         XOR     A
                                    264 
      0001A9 21 A3 C0         [12]  265         LD      HL,#.sys_time
      0001AC 22               [ 8]  266         LD      (HL+),A
      0001AD 77               [ 8]  267         LD      (HL),A
                                    268 
      0001AE E0 26            [12]  269         LDH     (.NR52),A       ; Turn sound off
                                    270 
      0001B0 CD 93 02         [24]  271         CALL    gsinit
                                    272 
      0001B3 FB               [ 4]  273         EI                      ; Enable interrupts
                                    274 
                                    275         ;; Call the main function
      0001B4 CD 00 02         [24]  276         CALL    _main
      0001B7                        277 _exit:: 
      0001B7                        278 99$:
      0001B7 76               [ 4]  279         HALT
      0001B8 00               [ 4]  280         NOP
      0001B9 18 FC            [12]  281         JR      99$             ; Wait forever
                                    282 
      0001BB                        283 _set_interrupts::
      0001BB F3               [ 4]  284         DI
      0001BC F8 02            [12]  285         LDA     HL,2(SP)        ; Skip return address
      0001BE AF               [ 4]  286         XOR     A
      0001BF E0 0F            [12]  287         LDH     (.IF),A         ; Clear pending interrupts
      0001C1 7E               [ 8]  288         LD      A,(HL)
      0001C2 FB               [ 4]  289         EI                      ; Enable interrupts
      0001C3 E0 FF            [12]  290         LDH     (.IE),A         ; interrupts are still disabled here
      0001C5 C9               [16]  291         RET
