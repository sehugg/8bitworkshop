      0001C6                        294 .start_refresh_OAM:
      0001C6 F0 92            [12]  295         LDH     A,(__shadow_OAM_base)
      0001C8 B7               [ 4]  296         OR      A
      0001C9 C8               [20]  297         RET     Z
      0001CA                        298 .refresh_OAM_DMA:
      0001CA E0 46            [12]  299         LDH     (.DMA),A        ; Put A into DMA registers
      0001CC 3E 28            [ 8]  300         LD      A,#0x28         ; We need to wait 160 ns
      0001CE                        301 1$:
      0001CE 3D               [ 4]  302         DEC     A
      0001CF 20 FD            [12]  303         JR      NZ,1$
      0001D1 C9               [16]  304         RET
      0001D2                        305 .end_refresh_OAM:
