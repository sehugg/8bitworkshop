                                    424         ;; Remove interrupt routine in BC from the VBL interrupt list
                                    425         ;; falldown to .remove_int
      000227                        426 .remove_VBL::
      000227 21 A5 C0         [12]  427         LD      HL,#.int_0x40
                                    428 
                                    429         ;; Remove interrupt BC from interrupt list HL if it exists
                                    430         ;; Abort if a 0000 is found (end of list)
      00022A                        431 .remove_int::
      00022A                        432 1$:
      00022A 2A               [ 8]  433         LD      A,(HL+)
      00022B 5F               [ 4]  434         LD      E,A
      00022C 56               [ 8]  435         LD      D,(HL)
      00022D 23               [ 8]  436         INC     HL
      00022E B2               [ 4]  437         OR      D
      00022F C8               [20]  438         RET     Z               ; No interrupt found
                                    439 
      000230 7B               [ 4]  440         LD      A,E
      000231 B9               [ 4]  441         CP      C
      000232 20 F6            [12]  442         JR      NZ,1$
      000234 7A               [ 4]  443         LD      A,D
      000235 B8               [ 4]  444         CP      B
      000236 20 F2            [12]  445         JR      NZ,1$
                                    446 
      000238 54               [ 4]  447         LD      D,H
      000239 5D               [ 4]  448         LD      E,L
      00023A 1B               [ 8]  449         DEC     DE
      00023B 1B               [ 8]  450         DEC     DE
                                    451 
                                    452         ;; Now do a memcpy from here until the end of the list
      00023C                        453 2$:
      00023C 2A               [ 8]  454         LD      A,(HL+)
      00023D 12               [ 8]  455         LD      (DE),A
      00023E 47               [ 4]  456         LD      B,A
      00023F 13               [ 8]  457         INC     DE
      000240 2A               [ 8]  458         LD      A,(HL+)
      000241 12               [ 8]  459         LD      (DE),A
      000242 13               [ 8]  460         INC     DE
      000243 B0               [ 4]  461         OR      B
      000244 C8               [20]  462         RET     Z
      000245 18 F5            [12]  463         JR      2$
                                    464 
                                    465         ;; Add interrupt routine in BC to the VBL interrupt list
                                    466         ;; falldown to .add_int
      000247                        467 .add_VBL::
      000247 21 A5 C0         [12]  468         LD      HL,#.int_0x40
                                    469 
                                    470         ;; Add interrupt routine in BC to the interrupt list in HL
      00024A                        471 .add_int::
      00024A                        472 1$:
      00024A 2A               [ 8]  473         LD      A,(HL+)
      00024B B6               [ 8]  474         OR      (HL)
      00024C 28 03            [12]  475         JR      Z,2$
      00024E 23               [ 8]  476         INC     HL
      00024F 18 F9            [12]  477         JR      1$
      000251                        478 2$:
      000251 78               [ 4]  479         LD      A,B
      000252 32               [ 8]  480         LD      (HL-),A
      000253 71               [ 8]  481         LD      (HL),C
      000254 C9               [16]  482         RET
                                    483 
                                    484         ;; Wait for VBL interrupt to be finished
      000255                        485 .wait_vbl_done::
      000255                        486 _wait_vbl_done::
                                    487         ;; Check if the screen is on
      000255 F0 40            [12]  488         LDH     A,(.LCDC)
      000257 E6 80            [ 8]  489         AND     #LCDCF_ON
      000259 C8               [20]  490         RET     Z               ; Return if screen is off
      00025A AF               [ 4]  491         XOR     A
      00025B E0 91            [12]  492         LDH     (.vbl_done),A   ; Clear any previous sets of vbl_done
      00025D                        493 1$:
      00025D 76               [ 4]  494         HALT                    ; Wait for any interrupt
      00025E 00               [ 4]  495         NOP                     ; HALT sometimes skips the next instruction
      00025F F0 91            [12]  496         LDH     A,(.vbl_done)   ; Was it a VBlank interrupt?
                                    497         ;; Warning: we may lose a VBlank interrupt, if it occurs now
      000261 B7               [ 4]  498         OR      A
      000262 28 F9            [12]  499         JR      Z,1$            ; No: back to sleep!
      000264 C9               [16]  500         RET
                                    501 
      000265                        502 .display_off::
      000265                        503 _display_off::
                                    504         ;; Check if the screen is on
      000265 F0 40            [12]  505         LDH     A,(.LCDC)
      000267 E6 80            [ 8]  506         AND     #LCDCF_ON
      000269 C8               [20]  507         RET     Z               ; Return if screen is off
      00026A                        508 1$:                             ; We wait for the *NEXT* VBL 
      00026A F0 44            [12]  509         LDH     A,(.LY)
      00026C FE 92            [ 8]  510         CP      #0x92           ; Smaller than or equal to 0x91?
      00026E 30 FA            [12]  511         JR      NC,1$           ; Loop until smaller than or equal to 0x91
      000270                        512 2$:
      000270 F0 44            [12]  513         LDH     A,(.LY)
      000272 FE 91            [ 8]  514         CP      #0x91           ; Bigger than 0x90?
      000274 38 FA            [12]  515         JR      C,2$            ; Loop until bigger than 0x90
                                    516 
      000276 F0 40            [12]  517         LDH     A,(.LCDC)
      000278 E6 7F            [ 8]  518         AND     #~LCDCF_ON
      00027A E0 40            [12]  519         LDH     (.LCDC),A       ; Turn off screen
      00027C C9               [16]  520         RET
                                    521 
      00027D                        522 _remove_VBL::
      00027D C5               [16]  523         PUSH    BC
      00027E F8 04            [12]  524         LDA     HL,4(SP)        ; Skip return address and registers
      000280 2A               [ 8]  525         LD      A,(HL+)
      000281 4F               [ 4]  526         LD      C,A
      000282 46               [ 8]  527         LD      B,(HL)
      000283 CD 27 02         [24]  528         CALL    .remove_VBL
      000286 C1               [12]  529         POP     BC
      000287 C9               [16]  530         RET
                                    531         
      000288                        532 _add_VBL::
      000288 C5               [16]  533         PUSH    BC
      000289 F8 04            [12]  534         LDA     HL, 4(SP)       ; Skip return address and registers
      00028B 2A               [ 8]  535         LD      A,(HL+)
      00028C 4F               [ 4]  536         LD      C,A
      00028D 46               [ 8]  537         LD      B,(HL)
      00028E CD 47 02         [24]  538         CALL    .add_VBL
      000291 C1               [12]  539         POP     BC
      000292 C9               [16]  540         RET
