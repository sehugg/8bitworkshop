                                    196         ;; Initialization code
      000157                        197 .code_start::
      000157 F3               [ 4]  198         DI                      ; Disable interrupts
      000158 57               [ 4]  199         LD      D, A            ; Store CPU type in D
      000159 58               [ 4]  200         LD      E, B            ; Store GBA flag in E 
                                    201         ;; Initialize the stack
      00015A 31 00 E0         [12]  202         LD      SP, #.STACK
                                    203 
      00015D CD B7 00         [24]  204         CALL    .clear_WRAM
                                    205 
                                    206 ;       LD      (.mode),A       ; Clearing (.mode) is performed when clearing RAM
                                    207 
