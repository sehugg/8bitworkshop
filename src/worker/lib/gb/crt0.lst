                                    381         ;; fills memory at HL of length BC with A, clobbers DE
      000201                        382 .memset_simple::
      000201 5F               [ 4]  383         LD      E, A
      000202 78               [ 4]  384         LD      A, B
      000203 B1               [ 4]  385         OR      C
      000204 C8               [20]  386         RET     Z
      000205 73               [ 8]  387         LD      (HL), E
      000206 0B               [ 8]  388         DEC     BC
      000207 54               [ 4]  389         LD      D, H
      000208 5D               [ 4]  390         LD      E, L
      000209 13               [ 8]  391         INC     DE
                                    392 
                                    393         ;; copies BC bytes from HL into DE
      00020A                        394 .memcpy_simple::
      00020A 78               [ 4]  395         LD      A, B
      00020B B1               [ 4]  396         OR      C
      00020C C8               [20]  397         RET     Z
                                    398 
      00020D CB 38            [ 8]  399         SRL     B
      00020F CB 19            [ 8]  400         RR      C
      000211 30 03            [12]  401         JR      NC,3$
      000213 2A               [ 8]  402         LD      A, (HL+)
      000214 12               [ 8]  403         LD      (DE), A
      000215 13               [ 8]  404         INC     DE
      000216                        405 3$:
      000216 04               [ 4]  406         INC     B
      000217 0C               [ 4]  407         INC     C
      000218 18 06            [12]  408         JR      2$
      00021A                        409 1$:
      00021A 2A               [ 8]  410         LD      A, (HL+)
      00021B 12               [ 8]  411         LD      (DE), A
      00021C 13               [ 8]  412         INC     DE
      00021D 2A               [ 8]  413         LD      A, (HL+)
      00021E 12               [ 8]  414         LD      (DE), A
      00021F 13               [ 8]  415         INC     DE
      000220                        416 2$:
      000220 0D               [ 4]  417         DEC     C
      000221 20 F7            [12]  418         JR      NZ,1$
      000223 05               [ 4]  419         DEC     B
      000224 20 F4            [12]  420         JR      NZ,1$   
      000226                        421 4$:
      000226 C9               [16]  422         RET
