                                    189         ;; soft reset: falldown to .code_start
      000150                        190 .reset::
      000150                        191 _reset::
      000150 FA A1 C0         [16]  192         LD      A, (__is_GBA)
      000153 47               [ 4]  193         LD      B, A
      000154 FA A0 C0         [16]  194         LD      A, (__cpu)
